# ============================================================
#  GUI DOTFILES .gitignore TEMPLATE
#  Principle: Track authored config, ignore generated state.
# ============================================================

# ── 1. SECRETS & CREDENTIALS ────────────────────────────────
# Never commit these. Use templating or a private repo instead.
.env
.env.*
*.local
*.secret
*_secret.*
# [REPLACE: Your specific cloud/CLI credential files]
# e.g., .config/gh/hosts.yml, .aws/, .kube/config

# ── 2. SHELL & COMMAND HISTORY ───────────────────────────────
# Contains pasted secrets, internal hostnames, and personal data.
.bash_history
.zsh_history
.fish_history
*_history
*_history.*
# [REPLACE: Any custom history file your shell uses]

# ── 3. MACHINE-SPECIFIC STATE ────────────────────────────────
# Generated per-machine and not portable.
# [REPLACE: Your monitor/display config]
#   e.g., hypr/monitors.lua, .config/sway/outputs/*
# [REPLACE: Your local font UUID markers]
.fonts/.uuid
.fonts/**/.uuid
# [REPLACE: Your local SSHFS or network mount aliases]
sshfs.list
# [REPLACE: Any host-specific includes or overrides]

# ── 4. WALLPAPER & THEME GENERATION OUTPUT ───────────────────
# Regenerated by scripts (matugen, pywal, etc.) from templates.
# Track the *templates*, ignore the *output*.
# [REPLACE: Your theme generator's output files]
#   e.g., .config/gtk-3.0/colors.css
#         .config/hypr/colors.lua
#         .config/waybar/colors.css
#         .config/kitty/themes/matugen.conf

# ── 5. GUI APPLICATION STATE & CACHES ────────────────────────
# User state, not portable config.
# [REPLACE: Your file manager's bookmarks]
#   e.g., .config/gtk-3.0/bookmarks
# [REPLACE: Your desktop database cache]
.local/share/applications/mimeinfo.cache
# [REPLACE: User-created application launchers]
.local/share/applications/userapp-*.desktop
# [REPLACE: Notification daemon state/logs]
#   e.g., .config/mako/history
# [REPLACE: Bar/panel runtime state]
#   e.g., .config/waybar/state
# [REPLACE: Launcher history/frecency]
#   e.g., .config/rofi/rofi.3.runcache

# ── 6. EDITOR & TOOL GENERATED FILES ─────────────────────────
# [REPLACE: Your editor's backup, swap, or cache files]
#   e.g., *.swp, *~, .nvim/,
#         .config/Code/User/workspaceStorage/
#         .local/share/nvim/lazy/
# [REPLACE: Tool-specific lockfiles or generated indexes]
#   e.g., .config/btop/btop.conf.bak

# ── 7. OS METADATA FILES ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 8. BUILD ARTIFACTS (if you compile anything in-repo) ─────
build/
dist/
*.o
*.pyc
__pycache__/
